<Project>
  <!--
    SINGLE PLACE to change the framework and package version.
    For .NET 10: PackagesMajor = 10.
    (In the Dockerfiles/compose the same version comes from DOTNET_MAJOR, see the README.)
  -->
  <PropertyGroup>
    <PackagesMajor Condition="'$(PackagesMajor)' == ''">10</PackagesMajor>
    <TargetFramework>net$(PackagesMajor).0</TargetFramework>
    <MsPackagesVersion>$(PackagesMajor).0.*</MsPackagesVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
