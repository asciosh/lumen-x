{
  "name": "Lumen-X",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [8081, 8080, 8000],
  "portsAttributes": {
    "8081": { "label": "Dashboard", "onAutoForward": "openBrowser" },
    "8080": { "label": "Backend API", "onAutoForward": "silent" },
    "8000": { "label": "Forecasting service", "onAutoForward": "silent" }
  },
  "postCreateCommand": "docker compose up -d --build && bash scripts/seed_demo.sh"
}
