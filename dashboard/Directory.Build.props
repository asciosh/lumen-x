<Project>
  <!--
    SINGLE PLACE to change the framework version (same logic as backend/Directory.Build.props).
    For .NET 8: PackagesMajor = 8. Keep it aligned with backend/ (the backend's Docker context is
    ./backend, so the file cannot be shared without moving it: this is a copy).
  -->
  <PropertyGroup>
    <PackagesMajor Condition="'$(PackagesMajor)' == ''">10</PackagesMajor>
    <TargetFramework>net$(PackagesMajor).0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
