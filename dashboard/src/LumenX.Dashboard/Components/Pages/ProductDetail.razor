@page "/products/{Id:int}"
@using System.Globalization
@using System.Text.Json
@inherits LocalizedComponentBase
@inject ILumenApiClient Api

<PageTitle>@(product?.Name ?? T("Product")) – Lumen-X</PageTitle>

<p class="crumb"><a href="/">@T("← All products")</a></p>

@if (pageError is not null)
{
    <div class="alert alert-error">@pageError</div>
}
else if (product is null)
{
    <p class="muted">@T("Loading…")</p>
}
else
{
    <div class="title-row">
        <h1>@product.Name</h1>
        @if (!string.IsNullOrEmpty(product.Sku))
        {
            <p class="muted sku">SKU: @product.Sku</p>
        }
    </div>

    <section class="card stage">
        <h2>@T("Forecast")</h2>
        <div class="row">
            <label>@T("Horizon (days, 1–90)")
                <input type="number" min="1" max="90" @bind="horizon" />
            </label>
            <label>@T("Method")
                <select @bind="method">
                    <option value="auto">auto</option>
                    <option value="naive">naive</option>
                    <option value="ets">ets</option>
                    <option value="lightgbm">lightgbm</option>
                </select>
            </label>
            <button class="btn" @onclick="RunForecastAsync" disabled="@forecasting">
                @(forecasting ? T("Computing…") : T("Compute forecast"))
            </button>
        </div>
        @if (forecastError is not null)
        {
            <div class="alert alert-error">@forecastError</div>
        }

        @if (forecast is null)
        {
            <p class="muted">@T("No forecast saved for this product.")</p>
        }
        else
        {
            @if (forecast.Forecast.Count > 0)
            {
                <p class="lead">
                    @T("Next {0} days: about", forecast.Forecast.Count) <strong>@FmtNum(forecast.Forecast.Sum(p => p.Yhat), 0)</strong>
                    @T("units, {0} per day.", FmtNum(forecast.Forecast.Average(p => p.Yhat), 0))
                </p>
            }

            <ForecastChart History="sales" Forecast="forecast" />
            <p class="muted">@T("The chart shows the last 120 days of history (among those loaded) and the forecast.")</p>

            <dl class="facts">
                <div><dt>@T("Method")</dt><dd><strong title="@(forecast.MethodUsed == "blend" ? T("Average of ETS and LightGBM") : null)">@forecast.MethodUsed</strong></dd></div>
                <div><dt>@T("Horizon")</dt><dd>@T("{0} days", forecast.Horizon)</dd></div>
                <div><dt>@T("Checked on")</dt><dd>@T("{0} days", forecast.HoldoutDays)</dd></div>
                <div><dt>@T("Days filled in")</dt><dd>@forecast.FilledMissingDays</dd></div>
                <div><dt>@T("Interval")</dt><dd>@IntervalText(forecast.Interval)</dd></div>
                <div><dt>@T("Computed on")</dt><dd>@FmtDateTime(forecast.CreatedAtUtc)</dd></div>
            </dl>

            <h3>@T("Explanation")</h3>
            <div class="row">
                <label>@T("Language")
                    <select value="@explainLang" @onchange="OnExplainLangChanged">
                        <option value="it">Italiano</option>
                        <option value="en">English</option>
                    </select>
                </label>
                <button class="btn btn-secondary" @onclick="RewriteWithAiAsync" disabled="@explaining">
                    @(explaining ? T("One moment…") : T("Rewrite with Gemini"))
                </button>
            </div>
            @if (explainError is not null)
            {
                <div class="alert alert-error">@explainError</div>
            }
            @if (explanation is not null)
            {
                <div class="explanation">@explanation.Text</div>
                <p class="muted">@T("Source: {0}{1}", SourceLabel(explanation.Source), NoteText(explanation.Note))</p>
            }

            <h3>@T("Reorder")</h3>
            <p class="muted">@T("How much to order so you do not run out of stock until the next delivery, based on the forecast and its error.")</p>
            <div class="row">
                <label>@T("Lead time (days)")
                    <input type="number" min="1" max="60" @bind="leadDays" />
                </label>
                <label>@T("Days between orders")
                    <input type="number" min="0" max="60" @bind="reviewDays" />
                </label>
                <label>@T("Service level")
                    <select @bind="serviceLevel">
                        <option value="90">90%</option>
                        <option value="95">95%</option>
                        <option value="98">98%</option>
                        <option value="99">99%</option>
                    </select>
                </label>
                <label>@T("Current stock (optional)")
                    <input @bind="onHandText" />
                </label>
                <button class="btn btn-secondary" @onclick="CalculateReorderAsync" disabled="@computingReorder">
                    @(computingReorder ? T("One moment…") : T("Compute reorder"))
                </button>
            </div>
            @if (reorderError is not null)
            {
                <div class="alert alert-error">@reorderError</div>
            }
            @if (reorder is not null)
            {
                <table class="table narrow">
                    <tbody>
                        <tr><td>@T("Period to cover")</td><td class="num">@T("{0} days", reorder.PeriodDays)</td></tr>
                        <tr><td>@T("Expected demand in the period")</td><td class="num">@FmtNum(reorder.DemandInPeriod, 0)</td></tr>
                        <tr><td>@T("Safety stock ({0}%)", reorder.ServiceLevelPercent)</td><td class="num">@FmtNum(reorder.SafetyStock, 0)</td></tr>
                        <tr><td>@T("Maximum level")</td><td class="num"><strong>@FmtNum(reorder.OrderUpToLevel, 0)</strong></td></tr>
                        @if (reorder.SuggestedOrder is double order)
                        {
                            <tr><td>@T("Suggested order (current stock {0})", FmtNum(reorder.OnHand ?? 0, 0))</td><td class="num"><strong>@FmtNum(order, 0)</strong></td></tr>
                        }
                    </tbody>
                </table>
                @foreach (var w in reorder.Warnings)
                {
                    <div class="alert alert-error">@ReorderWarning(w)</div>
                }
                <p class="muted">
                    @T("Safety stock = service-level factor × the method's daily error ({0}) × square root of the days in the period. It assumes errors are independent from one day to the next: if sales suddenly change level, the stock may turn out too low.", FmtNum(reorder.DailyErrorStdDev, 1))
                </p>
            }

            @if (forecast.Backtest is { Count: > 0 })
            {
                <h3>@T("How reliable it is")</h3>
                <p class="muted">@T("Average error on days the model had not seen: lower is better.")</p>
                <table class="table narrow">
                    <thead><tr><th>@T("Method")</th><th class="num">MAE</th><th class="num">RMSE</th></tr></thead>
                    <tbody>
                        @foreach (var kv in forecast.Backtest)
                        {
                            <tr class="@(kv.Key == forecast.MethodUsed ? "is-used" : null)">
                                <td>@kv.Key</td>
                                <td class="num">@FmtMetric(kv.Value.Mae)</td>
                                <td class="num">@FmtMetric(kv.Value.Rmse)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h3>@T("Day by day")</h3>
            <div class="scroll">
                <table class="table narrow">
                    <thead><tr><th>@T("Date")</th><th class="num">@T("Forecast")</th><th class="num">@T("Min")</th><th class="num">@T("Max")</th></tr></thead>
                    <tbody>
                        @foreach (var p in forecast.Forecast)
                        {
                            <tr>
                                <td>@FmtDate(p.Date)</td>
                                <td class="num">@FmtNum(p.Yhat, 1)</td>
                                <td class="num">@FmtNum(p.Lower, 1)</td>
                                <td class="num">@FmtNum(p.Upper, 1)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card chat">
        <h2>@T("Ask your data")</h2>
        <p class="muted">@T("Questions about sales, the forecast and what to order. The answers are computed by the code on your data, without inventing anything.")</p>
        <form class="ask" @onsubmit="AskAsync">
            <label>@T("Your question")
                <input @bind="questionText" @bind:event="oninput" maxlength="300" placeholder="@(T("For example: how much did I sell in the last 30 days?"))" />
            </label>
            <button type="button" class="btn" @onclick="AskAsync" disabled="@asking">@(asking ? T("One moment…") : T("Ask"))</button>
        </form>
        <div class="chips">
            @foreach (var example in ExampleQuestions)
            {
                <button type="button" class="chip" @onclick="() => AskExampleAsync(example)" disabled="@asking">@example</button>
            }
        </div>
        @if (askError is not null)
        {
            <div class="alert alert-error">@askError</div>
        }
        @foreach (var turn in conversation)
        {
            <div class="turn">
                <p class="q">@turn.Question</p>
                <p class="a">@turn.Answer</p>
            </div>
        }
    </section>

    <details class="card fold" open="@dataOpen">
        <summary><h2>@T("Sales")</h2></summary>
        <div class="row">
            <label>@T("From") <input type="date" value="@fromText" @onchange="OnFromChanged" /></label>
            <label>@T("To") <input type="date" value="@toText" @onchange="OnToChanged" /></label>
            <button class="btn" @onclick="ApplyFilterAsync" disabled="@loadingSales">@T("Apply")</button>
            <button class="btn btn-secondary" @onclick="ClearFilterAsync" disabled="@loadingSales">@T("Clear")</button>
        </div>
        @if (salesError is not null)
        {
            <div class="alert alert-error">@salesError</div>
        }
        @if (loadingSales)
        {
            <p class="muted">@T("Loading…")</p>
        }
        else if (sales.Count == 0)
        {
            <p class="muted">@T("No sales in the period. Import a CSV above.")</p>
        }
        else
        {
            <p>
                <strong>@sales.Count</strong> @T("days, from {0} to {1} · total {2} · average {3} per day", FmtDate(sales.First().Date), FmtDate(sales.Last().Date), FmtNum(sales.Sum(s => s.Quantity), 1), FmtNum(sales.Average(s => s.Quantity), 1))
            </p>
            <table class="table">
                <thead><tr><th>@T("Date")</th><th class="num">@T("Quantity")</th></tr></thead>
                <tbody>
                    @foreach (var s in sales.OrderByDescending(x => x.Date).Take(15))
                    {
                        <tr><td>@FmtDate(s.Date)</td><td class="num">@FmtNum(s.Quantity, 1)</td></tr>
                    }
                </tbody>
            </table>
            @if (sales.Count > 15)
            {
                <p class="muted">@T("Showing the last 15 rows.")</p>
            }
        }
    </details>

    <details class="card fold" open="@dataOpen">
        <summary><h2>@T("Import sales from CSV")</h2></summary>
        <p class="muted">@((MarkupString)T("Columns <code>date</code> and <code>quantity</code>. Separator comma or semicolon; dates yyyy-MM-dd or dd/MM/yyyy; decimals with a dot or a comma. Rows already present (same date) are updated."))</p>
        <InputFile OnChange="OnFileSelected" accept=".csv,text/csv" disabled="@importing" @key="fileInputKey" />
        @if (importing)
        {
            <p class="muted">@T("Import in progress…")</p>
        }
        @if (importError is not null)
        {
            <div class="alert alert-error">@importError</div>
        }
        @if (importResult is not null)
        {
            <div class="alert alert-ok">
                @T("Rows read: {0} · valid: {1} · inserted: {2} · updated: {3} · duplicates in the file: {4} · rejected: {5}", importResult.TotalRows, importResult.ValidRows, importResult.Inserted, importResult.Updated, importResult.DuplicatesInFile, importResult.Rejected)
            </div>
            @if (importResult.Errors.Count > 0)
            {
                <table class="table">
                    <thead><tr><th>@T("Row")</th><th>@T("Problem")</th></tr></thead>
                    <tbody>
                        @foreach (var e in importResult.Errors)
                        {
                            <tr><td>@e.Line</td><td>@e.Message</td></tr>
                        }
                    </tbody>
                </table>
                @if (importResult.ErrorsTruncated)
                {
                    <p class="muted">@T("Error list truncated: there are more.")</p>
                }
            }
        }
    </details>
}

@code {
    private const long MaxCsvBytes = 10 * 1024 * 1024;

    [Parameter] public int Id { get; set; }

    private int loadedId;
    private ProductDto? product;
    private List<SalePointDto> sales = new();
    private ForecastRunDto? forecast;

    private string? pageError;
    private string? salesError;
    private string? importError;
    private string? forecastError;
    private ImportResultDto? importResult;

    private bool loadingSales;
    private bool importing;
    private bool forecasting;
    private int fileInputKey;

    private int leadDays = 7;
    private int reviewDays = 7;
    private int serviceLevel = 95;
    private string onHandText = "";
    private ReorderSuggestionDto? reorder;
    private string? reorderError;
    private bool computingReorder;

    private bool dataOpen;
    private ExplanationDto? explanation;
    private string explainLang = LanguageState.English;
    private bool explaining;
    private string? explainError;

    private string fromText = "";
    private string toText = "";
    private void OnFromChanged(ChangeEventArgs e) => fromText = e.Value?.ToString() ?? "";
    private void OnToChanged(ChangeEventArgs e) => toText = e.Value?.ToString() ?? "";
    private int horizon = 28;
    private string method = "auto";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        explainLang = Lang.Current;
    }

    // When the interface language changes, the explanation is requested again in that language.
    protected override void LanguageChanged()
    {
        explainLang = Lang.Current;
        if (forecast is not null)
        {
            _ = ReloadExplanationAsync();
        }
    }

    private async Task ReloadExplanationAsync()
    {
        await LoadExplanationAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id) return;
        loadedId = Id;
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        product = null;
        pageError = null;
        forecast = null;
        explanation = null;
        reorder = null;
        importResult = null;
        conversation.Clear();
        questionText = "";
        askError = null;

        var p = await Api.GetProductAsync(Id);
        if (!p.IsSuccess)
        {
            pageError = p.For(Lang.Current);
            return;
        }
        product = p.Value;

        await LoadSalesAsync();
        dataOpen = sales.Count == 0;

        var f = await Api.GetLatestForecastAsync(Id);
        if (f.IsSuccess)
        {
            forecast = f.Value;
        }
        else if (f.StatusCode != 404)
        {
            forecastError = f.For(Lang.Current);
        }

        if (forecast is not null)
        {
            await LoadExplanationAsync(false);
        }
    }

    private static DateOnly? ParseDate(string text) =>
        DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? d
            : null;

    private async Task LoadSalesAsync()
    {
        salesError = null;
        var from = ParseDate(fromText);
        var to = ParseDate(toText);
        if (from.HasValue && to.HasValue && from.Value > to.Value)
        {
            salesError = T("'From' cannot be later than 'To'.");
            return;
        }

        loadingSales = true;
        try
        {
            var result = await Api.GetSalesAsync(Id, from, to);
            if (result.IsSuccess)
            {
                sales = result.Value!;
            }
            else
            {
                salesError = result.For(Lang.Current);
            }
        }
        finally
        {
            loadingSales = false;
        }
    }

    private Task ApplyFilterAsync() => LoadSalesAsync();

    private async Task ClearFilterAsync()
    {
        fromText = "";
        toText = "";
        await LoadSalesAsync();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        importError = null;
        importResult = null;
        var file = e.File;
        if (file is null) return;

        importing = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxCsvBytes);
            var result = await Api.ImportSalesAsync(Id, file.Name, stream);
            if (result.IsSuccess)
            {
                importResult = result.Value;
                await LoadSalesAsync();
            }
            else
            {
                importError = result.For(Lang.Current);
            }
        }
        catch (IOException)
        {
            importError = T("File too large (max 10 MB).");
        }
        finally
        {
            importing = false;
            fileInputKey++; // allows selecting the same file again
        }
    }

    private async Task RunForecastAsync()
    {
        forecastError = null;
        if (horizon < 1 || horizon > 90)
        {
            forecastError = T("The horizon must be between 1 and 90 days.");
            return;
        }

        forecasting = true;
        try
        {
            var result = await Api.CreateForecastAsync(Id, horizon, method);
            if (result.IsSuccess)
            {
                forecast = result.Value;
                reorder = null;
                await LoadExplanationAsync(false);
            }
            else
            {
                forecastError = result.For(Lang.Current);
            }
        }
        finally
        {
            forecasting = false;
        }
    }

    private async Task CalculateReorderAsync()
    {
        reorderError = null;
        double? onHand = null;
        if (!string.IsNullOrWhiteSpace(onHandText))
        {
            if (!double.TryParse(onHandText.Trim().Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
            {
                reorderError = T("Current stock must be a number (for example 300).");
                return;
            }
            onHand = parsed;
        }

        computingReorder = true;
        try
        {
            var result = await Api.GetReorderAsync(Id, leadDays, reviewDays, serviceLevel, onHand);
            if (result.IsSuccess)
            {
                reorder = result.Value;
            }
            else
            {
                reorder = null;
                reorderError = result.For(Lang.Current);
            }
        }
        finally
        {
            computingReorder = false;
        }
    }

    private string ReorderWarning(string code) => code switch
    {
        "intermittent" => T("Many zero-sales days in the history: the calculation assumes regular sales, so the suggested stock is not reliable."),
        _ => code
    };

    private static readonly string[] ItalianExamples =
    {
        "Quanto ho venduto negli ultimi 30 giorni?",
        "Come vanno le vendite rispetto al mese scorso?",
        "Qual è il giorno più forte della settimana?",
        "Quanto prevedo di vendere nelle prossime 2 settimane?",
        "Cosa conviene ordinare?",
        "Quanto è affidabile la previsione?"
    };

    private static readonly string[] EnglishExamples =
    {
        "How much did I sell in the last 30 days?",
        "How are sales doing compared to last month?",
        "Which day of the week sells best?",
        "How much will I sell in the next 2 weeks?",
        "What should I order?",
        "How reliable is the forecast?"
    };

    // The example questions follow the interface language (the backend understands both).
    private string[] ExampleQuestions => Lang.IsItalian ? ItalianExamples : EnglishExamples;

    private sealed record ChatTurn(string Question, string Answer);

    private readonly List<ChatTurn> conversation = new();
    private string questionText = "";
    private bool asking;
    private string? askError;

    private Task AskAsync() => SubmitQuestionAsync(questionText);

    private Task AskExampleAsync(string example)
    {
        questionText = example;
        return SubmitQuestionAsync(example);
    }

    private async Task SubmitQuestionAsync(string text)
    {
        askError = null;
        var question = (text ?? "").Trim();
        if (question.Length < 3)
        {
            askError = T("Write a question (at least 3 characters).");
            return;
        }

        asking = true;
        try
        {
            var result = await Api.AskAsync(Id, question, Lang.Current);
            if (result.IsSuccess)
            {
                conversation.Insert(0, new ChatTurn(question, result.Value!.Answer));
                if (conversation.Count > 8)
                {
                    conversation.RemoveAt(conversation.Count - 1);
                }

                questionText = "";
            }
            else
            {
                askError = result.For(Lang.Current);
            }
        }
        finally
        {
            asking = false;
        }
    }

    private async Task LoadExplanationAsync(bool useAi)
    {
        explainError = null;
        explaining = true;
        try
        {
            var result = await Api.GetExplanationAsync(Id, explainLang, useAi);
            if (result.IsSuccess)
            {
                explanation = result.Value;
            }
            else
            {
                explainError = result.For(Lang.Current);
            }
        }
        finally
        {
            explaining = false;
        }
    }

    private async Task OnExplainLangChanged(ChangeEventArgs e)
    {
        explainLang = e.Value?.ToString() == "en" ? "en" : "it";
        await LoadExplanationAsync(false);
    }

    private Task RewriteWithAiAsync() => LoadExplanationAsync(true);

    private string SourceLabel(string source) =>
        source == "gemini" ? T("Gemini (rewritten by the AI from the computed facts)") : T("rule-based template (no AI)");

    private string NoteText(string? note) => note switch
    {
        "ai_not_configured" => T(" · Gemini is not configured (GEMINI_API_KEY is missing): showing the template version."),
        "ai_unavailable" => T(" · Gemini did not answer (limits or error): showing the template version."),
        "ai_rejected" => T(" · Gemini wrote numbers that are not in the computed facts: showing the template version."),
        _ => ""
    };

    private static string IntervalText(JsonElement? e)
    {
        if (e is null) return "–";
        return e.Value.ValueKind == JsonValueKind.String
            ? (e.Value.GetString() ?? "–")
            : e.Value.GetRawText();
    }
}
