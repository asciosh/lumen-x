@page "/"
@page "/products"
@inherits LocalizedComponentBase
@inject ILumenApiClient Api

<PageTitle>@T("Products") – Lumen-X</PageTitle>

<h1>@T("Products")</h1>
<p class="lede">@T("Pick a product to see what I forecast and what to order, or create a new one.")</p>

@if (error is not null)
{
    <div class="alert alert-error">@error</div>
}

<section class="card">
    <h2>@T("New product")</h2>
    <div class="row">
        <label>@T("Name")
            <input @bind="newName" maxlength="200" />
        </label>
        <label>@T("SKU (optional)")
            <input @bind="newSku" maxlength="100" />
        </label>
        <button class="btn" @onclick="CreateAsync" disabled="@busy">@T("Create")</button>
    </div>
    @if (createError is not null)
    {
        <div class="alert alert-error">@createError</div>
    }
</section>

<section class="card">
    <h2>@T("List")</h2>
    @if (loading)
    {
        <p class="muted">@T("Loading…")</p>
    }
    else if (products.Count == 0)
    {
        <p class="muted">@T("No products yet. Create one above, then import the sales from a CSV.")</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>ID</th><th>@T("Name")</th><th>SKU</th><th>@T("Created")</th></tr>
            </thead>
            <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td><a href="/products/@p.Id">@p.Name</a></td>
                        <td>@p.Sku</td>
                        <td>@FmtDateTime(p.CreatedAtUtc)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private List<ProductDto> products = new();
    private bool loading = true;
    private bool busy;
    private string? error;
    private string? createError;
    private string newName = "";
    private string newSku = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var result = await Api.GetProductsAsync();
        if (result.IsSuccess)
        {
            products = result.Value!;
            error = null;
        }
        else
        {
            error = result.For(Lang.Current);
        }
        loading = false;
    }

    private async Task CreateAsync()
    {
        createError = null;
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = T("Enter a name.");
            return;
        }

        busy = true;
        try
        {
            var sku = string.IsNullOrWhiteSpace(newSku) ? null : newSku.Trim();
            var result = await Api.CreateProductAsync(newName.Trim(), sku);
            if (result.IsSuccess)
            {
                newName = "";
                newSku = "";
                await LoadAsync();
            }
            else
            {
                createError = result.For(Lang.Current);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
