@using System.Globalization
@using System.Text
@inherits LocalizedComponentBase

@if (svgHtml is null)
{
    <p class="muted">@T("No data to show.")</p>
}
else
{
    <div class="chart-wrap">@((MarkupString)svgHtml)</div>
    <div class="legend">
        <span><i class="sw sw-history"></i> @T("History")</span>
        <span><i class="sw sw-yhat"></i> @T("Forecast")</span>
        <span><i class="sw sw-band"></i> @T("Likely range (min–max)")</span>
    </div>
}

@code {
    private const double W = 800, H = 340, Left = 72, Right = 18, Top = 18, Bottom = 38;

    [Parameter] public IReadOnlyList<SalePointDto>? History { get; set; }
    [Parameter] public ForecastRunDto? Forecast { get; set; }
    [Parameter] public int MaxHistoryDays { get; set; } = 120;

    private string? svgHtml;

    protected override void OnParametersSet()
    {
        svgHtml = BuildSvg();
    }

    // Axis labels use the language's number and date style, so the drawing is rebuilt when the language changes.
    protected override void LanguageChanged()
    {
        svgHtml = BuildSvg();
    }

    // Drawing coordinates always use a dot as decimal separator, whatever the server culture.
    private static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>"Nice" bounds and step for the vertical axis (1, 2, 5 x a power of 10), so the ticks are readable.</summary>
    private static (double Min, double Max, double Step) NiceScale(double lo, double hi)
    {
        var range = hi - lo;
        if (range <= 0)
        {
            range = Math.Max(1.0, Math.Abs(hi));
        }

        var padded = range * 1.06;
        var rough = padded / 4.0;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        var fraction = rough / magnitude;
        var step = (fraction <= 1 ? 1 : fraction <= 2 ? 2 : fraction <= 5 ? 5 : 10) * magnitude;

        var min = Math.Floor((lo - range * 0.03) / step) * step;
        if (lo >= 0 && min < 0)
        {
            min = 0;
        }
        var max = Math.Ceiling((hi + range * 0.03) / step) * step;
        if (max <= min)
        {
            max = min + step;
        }
        return (min, max, step);
    }

    // The markup is built here as a string (only numbers and dates formatted by the code, no text typed by the
    // user) because <text> inside Razor blocks would be interpreted by Razor.
    private string? BuildSvg()
    {
        var hist = (History ?? Array.Empty<SalePointDto>()).OrderBy(p => p.Date).ToList();
        if (hist.Count > MaxHistoryDays)
        {
            hist = hist.Skip(hist.Count - MaxHistoryDays).ToList();
        }

        IReadOnlyList<ForecastPointView> fc = Forecast?.Forecast ?? new List<ForecastPointView>();
        if (hist.Count == 0 && fc.Count == 0) return null;

        var dates = hist.Select(p => p.Date).Concat(fc.Select(p => p.Date)).ToList();
        var xStart = dates.Min();
        var xEnd = dates.Max();
        double span = Math.Max(1, xEnd.DayNumber - xStart.DayNumber);

        var values = hist.Select(p => p.Quantity)
            .Concat(fc.SelectMany(p => new[] { p.Yhat, p.Lower, p.Upper }))
            .ToList();
        var (yMin, yMax, step) = NiceScale(values.Min(), values.Max());

        double X(DateOnly d) => Left + (d.DayNumber - xStart.DayNumber) / span * (W - Left - Right);
        double Y(double v) => Top + (1 - (v - yMin) / (yMax - yMin)) * (H - Top - Bottom);
        string Pt(DateOnly d, double v) => N(X(d)) + "," + N(Y(v));

        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {N(W)} {N(H)}' class='chart' role='img' aria-label='{T("Sales history and forecast")}'>");
        sb.Append("<defs><linearGradient id='lx-band' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append("<stop class='band-top' offset='0'/><stop class='band-bottom' offset='1'/></linearGradient></defs>");

        // Horizontal grid and Y-axis labels, at round steps
        var decimals = step >= 1 ? 0 : (step >= 0.1 ? 1 : 2);
        var tickCount = (int)Math.Round((yMax - yMin) / step);
        for (int i = 0; i <= tickCount; i++)
        {
            double v = yMin + i * step;
            double y = Y(v);
            sb.Append($"<line x1='{N(Left)}' x2='{N(W - Right)}' y1='{N(y)}' y2='{N(y)}' class='grid'/>");
            sb.Append($"<text x='{N(Left - 10)}' y='{N(y + 4)}' text-anchor='end' class='tick'>{Fmt.Num(v, decimals, Lang.Current)}</text>");
        }

        // X-axis labels
        for (int i = 0; i <= 4; i++)
        {
            var d = xStart.AddDays((int)Math.Round(span * i / 4.0));
            // First label aligned to the left and last to the right: this way they do not leave the drawing.
            var anchor = i == 4 ? "end" : (i == 0 ? "start" : "middle");
            sb.Append($"<text x='{N(X(d))}' y='{N(H - 12)}' text-anchor='{anchor}' class='tick'>{Fmt.ShortDate(d, Lang.Current)}</text>");
        }

        // Interval band (upper going forward, lower coming back)
        if (fc.Count > 0)
        {
            var upper = fc.Select(p => Pt(p.Date, p.Upper));
            var lower = fc.Reverse().Select(p => Pt(p.Date, p.Lower));
            sb.Append($"<polygon points='{string.Join(" ", upper.Concat(lower))}' class='band'/>");
        }

        // Where the history ends and the forecast begins
        if (hist.Count > 0 && fc.Count > 0)
        {
            var sx = N(X(hist[^1].Date));
            sb.Append($"<line x1='{sx}' x2='{sx}' y1='{N(Top)}' y2='{N(H - Bottom)}' class='split'/>");
        }

        if (hist.Count > 0)
        {
            sb.Append($"<polyline points='{string.Join(" ", hist.Select(p => Pt(p.Date, p.Quantity)))}' pathLength='1' class='line-history'/>");
        }

        if (fc.Count > 0)
        {
            sb.Append($"<polyline points='{string.Join(" ", fc.Select(p => Pt(p.Date, p.Yhat)))}' class='line-yhat'/>");
        }

        if (hist.Count > 0 && fc.Count > 0)
        {
            var last = hist[^1];
            sb.Append($"<circle cx='{N(X(last.Date))}' cy='{N(Y(last.Quantity))}' r='4.6' class='dot'/>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }
}
