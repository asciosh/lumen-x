{
  // Lumen-X, Cloudflare edition. See README.md for the setup, step by step.
  "name": "lumen-x",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-11-01",

  // The dashboard (static files). The Worker code runs first only for the API and the login.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // The database. Replace the id with the one of the D1 database you create (Storage & databases -> D1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumenx",
      "database_id": "PUT-THE-ID-OF-YOUR-D1-DATABASE-HERE"
    }
  ],

  // The login settings are NOT here: they are secrets. Set them in the dashboard (the Worker -> Settings ->
  // Variables and secrets, type "Secret"), so that a deploy never overwrites them and they never reach the repo:
  //   SESSION_SECRET         random text, at least 32 characters (signs the session cookies)
  //   GITHUB_CLIENT_ID       from the GitHub OAuth app
  //   GITHUB_CLIENT_SECRET   from the GitHub OAuth app
  //   ALLOWED_GITHUB_USERS   the GitHub usernames that may sign in, for example: alice, bob
  // While they are missing, every request to the API and to the login is refused (closed by default).

  // Only the main address. Preview addresses would be public.
  "workers_dev": true,
  "preview_urls": false
}
